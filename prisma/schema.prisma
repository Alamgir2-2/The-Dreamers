generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id                 String   @id @default(uuid())
  name               String   @unique
  location           String?
  phone              String?
  email              String?
  yearsActive        Int      @default(0)
  bloodDonations     Int      @default(0)
  presidentEducation String?
  presidentQuote     String?
  presidentMission   String?
  memberIds          String[]
  eventIds           String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  presidentId        String?
}

model OrgPosition {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model OrgBranch {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Donor {
  id           String   @id @default(uuid())
  name         String
  bloodGroup   String
  phone        String
  address      String
  institute    String
  lastDonation DateTime
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([bloodGroup])
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  bloodGroup        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  college           String?
  currentAddress    String?
  department        String?
  hscBatch          String?
  lastBloodDonation DateTime?
  mobile            String?
  permanentAddress  String?
  photo             String?
  school            String?
  sscBatch          String?
  university        String?
  designation       String?
  institution       String?
  orgBranch         String?
  orgJoinDate       DateTime?
  orgPosition       String?
  professionType    String?
  specialization    String?
  isAdmin           Boolean   @default(false)
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime
  location    String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
